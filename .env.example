# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=FiberMaxxing Kitchen

# --- Database (Cloudflare D1) --------------------------------------------
# Text lives in D1. The Vercel runtime reaches it over Cloudflare's HTTP API
# because Vercel cannot hold a D1 binding.
#
#   1. Create a D1 database in the Cloudflare dashboard and copy its id.
#   2. Create an API token with the "D1: Edit" permission.
#   3. Fill these in, then run `npm run db:init` once.
#
# Leave them empty in local development and the app uses web/.data/kitchen.db
# through Node's built-in SQLite driver instead.
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_D1_API_TOKEN=
# Optional: override the local SQLite file path.
# LOCAL_DB_PATH=.data/kitchen.db

# --- Photo storage (Cloudflare R2) ---------------------------------------
# R2 speaks the S3 API. Create a bucket, then an R2 API token with
# "Object Read & Write" for that bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fibermaxxing-recipes
# Public delivery for the bucket: a custom domain (best) or its r2.dev URL.
# Without it, images are streamed through /api/images/... on Vercel.
R2_PUBLIC_BASE_URL=

# --- Moderation -----------------------------------------------------------
# No visitor accounts. /admin is unlocked with this one shared key.
# Use a long random string, e.g. `openssl rand -base64 32`.
ADMIN_KEY=replace-with-a-long-random-string

# --- Spam protection ------------------------------------------------------
# dev.turnstile.com test keys, or your own from dash.cloudflare.com.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Copyright ------------------------------------------------------------
# A monitored inbox shown on /dmca. Replace before publishing.
DMCA_AGENT_EMAIL=copyright@your-domain.com

# --- Account deletion -----------------------------------------------------
# A monitored inbox shown on /account-deletion. Replace before publishing.
ACCOUNT_DELETION_EMAIL=privacy@your-domain.com

# --- App store link -------------------------------------------------------
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.slothdev.fibermaxxing

# --- USDA FoodData Central ------------------------------------------------
# Live lookups for foods the local catalog does not have yet. Every result is
# cached in D1, so a repeated search never calls USDA twice.
# https://fdc.nal.usda.gov/api-key-signup.html
FDC_API_KEY=
